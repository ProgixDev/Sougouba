# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
# `.env` carries the Mapbox *secret* download token (sk.…), which is a build
# credential and must never be committed. `.env.example` documents the names.
.env
.env*.local
!.env.example

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
.image-cache/

# web (landing page)
web/node_modules/
web/.next/
admin/.next/
web/out/
web/next-env.d.ts
web/tsconfig.tsbuildinfo
web/public/img/_master/
