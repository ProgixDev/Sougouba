NODE_ENV=development
PORT=3000

# Supabase project settings → Database → Connection string (use the pooled
# "Transaction" connection for serverless/edge deploys, "Session" for a
# long-lived server process like this one).
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres

# Supabase project settings → API. The auth guard fetches this project's own
# JWKS to verify tokens — no separate secret/key needed here for that.
SUPABASE_URL=https://wyjkaiquugoblvvzpjnq.supabase.co

# Phase 3/7.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Phase 1/5 — same Mapbox account the mobile app's map rendering already uses.
MAPBOX_SECRET_TOKEN=

# Phase 9.
OPENAI_API_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=
