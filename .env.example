# Mapbox credentials. Copy to `.env` and fill in — `.env` is gitignored.
#
# Two different tokens, doing two different jobs:
#
#   RNMAPBOX_MAPS_DOWNLOAD_TOKEN  a SECRET token (sk.…) with the DOWNLOADS:READ
#                                 scope. Read at *build* time so Gradle and
#                                 CocoaPods can fetch the native Mapbox SDK.
#                                 Never ships in the app bundle. Rotate it if it
#                                 ever leaks.
#
#   EXPO_PUBLIC_MAPBOX_PUBLIC_TOKEN  the PUBLIC token (pk.…). Read at *runtime*
#                                 by `lib/mapbox.ts`. The `EXPO_PUBLIC_` prefix
#                                 is what makes Expo inline it into the bundle,
#                                 so it is public by construction — restrict it
#                                 by URL/bundle id in the Mapbox dashboard
#                                 rather than trying to hide it.
#
# Both at https://console.mapbox.com/account/access-tokens/
#
# Without them the app still builds and runs: `components/map/MapFallback.tsx`
# draws a branded static panel wherever a map would go.

RNMAPBOX_MAPS_DOWNLOAD_TOKEN=
EXPO_PUBLIC_MAPBOX_PUBLIC_TOKEN=

# Stripe, client side. The PUBLISHABLE key (pk_…) only — it ships in the app
# bundle and is meant to be public. The secret key lives in sougouba-api/.env
# and must never appear here.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
