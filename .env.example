NODE_ENV=development
PORT=3000

# ── DATABASE_URL ────────────────────────────────────────────────────────────
#
# Take the line below, replace [YOUR-DB-PASSWORD] with the database password
# from Supabase → Project Settings → Database, and put it in `.env`. Nothing
# else needs changing: host, port, database and username are this project's,
# confirmed against the live pooler on 2026-09-03.
#
#   postgresql://postgres.wyjkaiquugoblvvzpjnq:[YOUR-DB-PASSWORD]@aws-1-eu-west-1.pooler.supabase.com:5432/postgres
#
# ⚠️ **Use the pooler host above, not the "direct connection" string the
# dashboard offers first.** `db.wyjkaiquugoblvvzpjnq.supabase.co` publishes an
# AAAA record and no A record at all — it is IPv6-only, and plenty of home and
# office networks have no IPv6 route (the Mac this was built on does not). The
# direct string then fails with a DNS/connect error that reads like a bad
# password and is not one. The pooler answers on IPv4.
#
# Port 5432 is session mode, which is what a long-lived server process like
# this one wants; 6543 is transaction mode, for serverless. Either works here —
# `db/client.ts` already passes `prepare: false`, which is what transaction
# mode requires and postgres.js does not default to.
#
# Note the username: `postgres.<project-ref>`, not plain `postgres`. The pooler
# reads the tenant out of it; a bare `postgres` gets "Tenant or user not found",
# which is also the error you get from the wrong region.
DATABASE_URL=

# Supabase project settings → API. The auth guard fetches this project's own
# JWKS to verify tokens — no separate secret/key needed here for that.
SUPABASE_URL=https://wyjkaiquugoblvvzpjnq.supabase.co

# Phase 3/7 — the SECRET key (sk_…). The publishable key (pk_…) is the mobile
# app's, never this one's.
#
# Test-mode verified 2026-09-03: `npm run verify:stripe` walks the whole payment
# path against live test-mode Stripe — intent created, paid with pm_card_visa,
# verified four ways, refunded, webhook signatures accepted and rejected.
STRIPE_SECRET_KEY=

# From the Stripe dashboard when the webhook endpoint is registered. Until then
# `verify:stripe` signs its own payloads to exercise the signature check; the
# real value is still needed before any webhook can be received.
STRIPE_WEBHOOK_SECRET=

# Phase 1/5 — the account's SECRET token (sk.…), not the public pk. one the
# client bundle carries.
#
# Already available: the mobile repo's own .env carries an sk. token as
# RNMAPBOX_MAPS_DOWNLOAD_TOKEN, and it geocodes — verified against the live
# Mapbox API on 2026-09-03. Copy that value here.
#
# ⚠️ It is nominally the *downloads* token for the native SDK build, so one
# secret is now doing two jobs: rotate it for the mobile build and server-side
# geocoding stops with it. A dedicated server token is the tidier answer before
# launch.
MAPBOX_SECRET_TOKEN=

# Phase 9.
OPENAI_API_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=
