# Copy to `.env.local` (gitignored by Next.js) and fill in.
#
# Every var here is `NEXT_PUBLIC_`, meaning Next inlines it into the browser
# bundle. That is correct for all three: the API base URL and the Supabase
# project URL are addresses, and the publishable key is designed to be public —
# it grants nothing on its own, because Row Level Security and this project's
# `AdminGuard` decide what a caller may actually do.
#
# The service-role key must NEVER appear in this file. It lives only in
# sougouba-api/.env, server-side.

# The NestJS API (sougouba-api). `npm run start:dev` there listens on 3000.
NEXT_PUBLIC_API_URL=http://localhost:3000

# Supabase project settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://wyjkaiquugoblvvzpjnq.supabase.co

# The PUBLISHABLE key (sb_publishable_…), not the anon JWT and not service-role.
# Used only to sign in; the resulting access token is what the API verifies
# against the project's JWKS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
