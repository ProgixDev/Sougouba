node_modules/
dist/
coverage/
.env
.env.local
*.log
*.tsbuildinfo
.DS_Store

# Expo artifacts, which have no business in a NestJS folder. A stray
# `npx expo` run in here once generated app.json plus a whole ios/ project for
# a phantom "sougoubaapi" app, and the root .gitignore could not catch them: it
# anchors the native folders as `/ios` and `/android`, which matches the mobile
# app at the repo root and nothing nested.
app.json
ios/
android/
.vercel

# `vercel link` wrote `.env*` here, which would also hide `.env.example` — the
# one env file that is meant to be committed, since it is how anyone knows
# which variables exist. Kept, with the exception the root .gitignore uses.
.env*
!.env.example
