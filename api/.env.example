NODE_ENV=development
PORT=3000


# ── The database connection ─────────────────────────────────────────────────
#
# There is no DATABASE_URL any more. This API reaches Postgres over PostgREST
# (`src/db/client.ts`), so the project URL plus the service-role key *are* the
# database credentials — no connection string, no password, no IPv6 pooler
# host to get right.
#
# Supabase project settings → API.
SUPABASE_URL=https://wyjkaiquugoblvvzpjnq.supabase.co

# ⚠️ Project settings → API → `service_role`. **This key bypasses RLS
# entirely** — it is exactly as privileged as the database password it
# replaced, and a leak of it is a full database compromise. Server-side only:
# it must never appear in the mobile bundle, the admin bundle, a log line or
# an error response.
SUPABASE_SERVICE_ROLE_KEY=

# Browser origins allowed to call this API cross-origin, comma-separated.
#
# Leave it unset in development: `config/cors.ts` then falls back to
# http://localhost:4320 (and 127.0.0.1:4320), which is the admin dashboard's
# `next dev` port. Unset in *production* means no cross-origin browser access
# at all — the fallback is deliberately not applied there.
#
# ⚠️ No trailing slash. `http://localhost:4320/` is the most common way this
# silently fails: a browser's `Origin` header never carries a path, so the
# compare misses and Chrome reports a generic CORS error that says nothing
# about a slash. (`config/cors.ts` strips it defensively, but don't rely on it
# in a value someone else has to read.)
#
#   CORS_ALLOWED_ORIGINS=https://admin.sougouba.ca,https://sougouba.ca
CORS_ALLOWED_ORIGINS=

# Phase 3/7 — the SECRET key (sk_…). The publishable key (pk_…) is the mobile
# app's, never this one's.
#
# Test-mode verified 2026-09-03: `npm run verify:stripe` walks the whole payment
# path against live test-mode Stripe — intent created, paid with pm_card_visa,
# verified four ways, refunded, webhook signatures accepted and rejected.
STRIPE_SECRET_KEY=

# From the Stripe dashboard when the webhook endpoint is registered. Until then
# `verify:stripe` signs its own payloads to exercise the signature check; the
# real value is still needed before any webhook can be received.
STRIPE_WEBHOOK_SECRET=

# Phase 1/5 — the account's SECRET token (sk.…), not the public pk. one the
# client bundle carries.
#
# Already available: the mobile repo's own .env carries an sk. token as
# RNMAPBOX_MAPS_DOWNLOAD_TOKEN, and it geocodes — verified against the live
# Mapbox API on 2026-09-03. Copy that value here.
#
# ⚠️ It is nominally the *downloads* token for the native SDK build, so one
# secret is now doing two jobs: rotate it for the mobile build and server-side
# geocoding stops with it. A dedicated server token is the tidier answer before
# launch.
MAPBOX_SECRET_TOKEN=

# Push notifications — sent through Expo's push service. The FCM and APNs
# credentials go into the EAS project (`eas credentials`), not here. Only needed
# once "Enhanced security for push notifications" is on in the Expo project.
EXPO_ACCESS_TOKEN=

# Support assistant. Empty = the assistant answers "not available yet" (503).
OPENAI_API_KEY=
OPENAI_MODEL=

# Outgoing mail (sign-up codes), via Nodemailer. Leave SMTP_HOST empty to
# simulate: the code is printed in this server's console instead of emailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Sougouba <no-reply@sougouba.com>"

# ── Hosting ──────────────────────────────────────────────────────────────────
#
# Who drives the background jobs. Leave both empty for a local run or a VPS:
# the in-process timers in courier/dispatch.scheduler.ts (every 5 s),
# billing/payouts.scheduler.ts (Friday 03:00) and admin/retention.scheduler.ts
# (daily 04:00) own them, which is how they were built and tested.
#
# Vercel sets VERCEL=1 itself, so a Vercel deploy needs nothing here: the
# timers stand down and the platform's cron calls /internal/cron/* instead, per
# vercel.json. Set SERVERLESS=1 by hand only to reproduce that locally, or on
# another host that cannot keep a process alive between requests.
SERVERLESS=

# The secret /internal/cron/* is guarded with, sent by the scheduler as
# `Authorization: Bearer <value>`.
#
# ⚠️ Unset means every scheduled job is refused — no dispatch, no payouts, no
# purge — because the alternative default would leave the payout button open to
# anyone who finds the URL. Required on any serverless deploy; irrelevant on a
# VPS, where the timers run and nothing calls these routes.
#
# Vercel generates one under Settings → Cron Jobs; copy that value into the
# project's environment variables so the guard compares against the same string.
# Anywhere else: `openssl rand -hex 32`.
CRON_SECRET=

# ── Test-phase authentication bypass ─────────────────────────────────────────
#
# Set to 1 and the fixed code 000000 signs in as ANY account, with no email
# sent. It exists because the app's only way in is an emailed code, so a deploy
# with no mail provider is a deploy nobody can log into; with this, the
# TestFlight group gets in without SMTP.
#
# ⚠️⚠️ THIS IS AN AUTHENTICATION BYPASS, not a convenience. Anyone who knows an
# address — a tester, a merchant, the administrator — signs in as them with six
# zeros. It is also the only thing standing between the open internet and
# /admin, which can refund payments and change commission rates.
#
# Unset it before the app is delivered, before the VPS deploy, and before the
# build goes to anyone outside the test group. Leaving SMTP_HOST set makes it
# irrelevant (codes go back to random), and with it unset the API refuses to
# boot in production without SMTP rather than failing quietly.
ALLOW_FIXED_TEST_OTP=

# Test phase only. When set, a pending courier can approve their own file with
# POST /couriers/me/demo-approve — what the app's "Simuler l'approbation" button
# calls. Unset, that route is a 404. ⚠️ It skips the human review; unset it
# together with ALLOW_FIXED_TEST_OTP before delivery.
ALLOW_DEMO_SELF_APPROVAL=
